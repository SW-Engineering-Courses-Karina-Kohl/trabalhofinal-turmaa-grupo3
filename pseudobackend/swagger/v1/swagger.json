{
  "openapi": "3.0.1",
  "info": {
    "title": "API V1",
    "version": "v1",
    "description": "API endpoints for SalesOps"
  },
  "paths": {
    "/api/v1/commissions": {
      "get": {
        "summary": "Get List of all reports",
        "tags": [
          "Commission Reports"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "reports",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "filename": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "received",
                              "processing",
                              "processed",
                              "failed"
                            ]
                          },
                          "commission_pool": {
                            "type": "number"
                          },
                          "seller_count": {
                            "type": "integer"
                          },
                          "average_payout": {
                            "type": "number"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "total_pages": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "page",
                    "size",
                    "total",
                    "total_pages"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commissions/{id}": {
      "get": {
        "summary": "Get a report",
        "tags": [
          "Commission Reports"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "received",
                        "processing",
                        "processed",
                        "failed"
                      ]
                    },
                    "commission_pool": {
                      "type": "number"
                    },
                    "seller_count": {
                      "type": "integer"
                    },
                    "average_payout": {
                      "type": "number"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "filename",
                    "status",
                    "commission_pool",
                    "seller_count",
                    "average_payout"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete report",
        "tags": [
          "Delete a specific report"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "sales csv received",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commissions/{id}/sellers": {
      "get": {
        "summary": "Get the sellers of a report",
        "tags": [
          "Commission Sellers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "report_sellers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "initials": {
                            "type": "string"
                          },
                          "total_sales": {
                            "type": "number"
                          },
                          "commission_rate": {
                            "type": "number"
                          },
                          "final_commission": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "total_pages": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "page",
                    "size",
                    "total",
                    "total_pages"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commissions/{id}/export": {
      "post": {
        "summary": "Generate commissions report",
        "tags": [
          "Commission Sellers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "doc_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "report_sellers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "comission_report_id": {
                      "type": "integer"
                    },
                    "type": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "type",
                    "comission_report_id",
                    "id"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exports": {
      "get": {
        "summary": "Get all exports (.csv or .pdf)",
        "tags": [
          "Exports type .csv and .pdf"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "sales csv received",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "comission_report_id": {
                            "type": "integer"
                          },
                          "filename": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "total_pages": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "page",
                    "size",
                    "total",
                    "total_pages"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/exports/{id}": {
      "get": {
        "summary": "Get all exports (.csv or .pdf)",
        "tags": [
          "Exports type .csv and .pdf of a comission report"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "sales csv received",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "comission_report_id": {
                      "type": "integer"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "comission_report_id",
                    "filename",
                    "url",
                    "type",
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads": {
      "post": {
        "summary": "Upload Sales Report (.csv)",
        "tags": [
          "Sales Report"
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "sales csv received",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "received",
                        "processing",
                        "processed",
                        "failed"
                      ]
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "filename",
                    "status",
                    "created_at"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "invalid csv (send invalid type)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/csv": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://api.localhost"
    }
  ]
}