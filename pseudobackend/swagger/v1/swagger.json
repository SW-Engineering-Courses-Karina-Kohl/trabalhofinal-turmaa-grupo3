{
  "openapi": "3.0.1",
  "info": {
    "title": "API V1",
    "version": "v1",
    "description": "API endpoints for SalesOps"
  },
  "paths": {
    "/api/v1/commisions/batches": {
      "get": {
        "summary": "Get List of all reports",
        "tags": [
          "Commission Reports"
        ],
        "responses": {
          "200": {
            "description": "reports",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "filename": {
                            "type": "string"
                          },
                          "batch_number": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "received",
                              "processing",
                              "processed",
                              "failed"
                            ]
                          },
                          "commission_pool": {
                            "type": "number"
                          },
                          "seller_count": {
                            "type": "integer"
                          },
                          "average_payout": {
                            "type": "number"
                          },
                          "validation_passed": {
                            "type": "string"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "page_size": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "total_pages": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "page",
                    "page_size",
                    "total",
                    "total_pages"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commisions/batches/{id}": {
      "get": {
        "summary": "Get a report",
        "tags": [
          "Commission Reports"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "batch_number": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "received",
                        "processing",
                        "processed",
                        "failed"
                      ]
                    },
                    "commission_pool": {
                      "type": "number"
                    },
                    "seller_count": {
                      "type": "integer"
                    },
                    "average_payout": {
                      "type": "number"
                    },
                    "validation_passed": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "filename",
                    "status",
                    "commission_pool",
                    "seller_count",
                    "average_payout"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/commisions/batches/{id}/sellers": {
      "get": {
        "summary": "Get the sellers of a report",
        "tags": [
          "Commission Sellers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "report_sellers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "initials": {
                            "type": "string"
                          },
                          "total_sales": {
                            "type": "number"
                          },
                          "commission_rate": {
                            "type": "number"
                          },
                          "final_commission": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "page_size": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    },
                    "total_pages": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data",
                    "page",
                    "page_size",
                    "total",
                    "total_pages"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/uploads": {
      "post": {
        "summary": "Upload Sales Report (.csv)",
        "tags": [
          "Sales Report"
        ],
        "parameters": [],
        "responses": {
          "201": {
            "description": "sales csv received",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "received",
                        "processing",
                        "processed",
                        "failed"
                      ]
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "filename",
                    "status",
                    "created_at"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "invalid csv (send invalid type)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "[\"text/csv\", \"application/csv\", \"text/plain\"]": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://{defaultHost}",
      "variables": {
        "defaultHost": {
          "default": "localhost:3000"
        }
      }
    }
  ]
}