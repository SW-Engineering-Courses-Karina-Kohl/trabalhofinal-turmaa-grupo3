# ================== BUILD STAGE ==================
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

COPY pom.xml .
COPY mvnw .
COPY .mvn .mvn

RUN ./mvnw dependency:go-offline -B

COPY src ./src

# WildFly plugin packages the server + app together under target/server
RUN ./mvnw clean package -Pprod -DskipTests

# ================== RUNTIME STAGE ==================
FROM quay.io/wildfly/wildfly:35.0.1.Final-jdk17

# Copy the provisioned WildFly server from the build stage
COPY --from=build /app/target/server /opt/jboss/wildfly

EXPOSE 8080

CMD ["/opt/jboss/wildfly/bin/standalone.sh", "-b", "0.0.0.0"]