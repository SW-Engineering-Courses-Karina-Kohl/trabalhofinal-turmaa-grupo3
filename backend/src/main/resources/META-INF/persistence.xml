<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1" xmlns="https://jakarta.ee/xml/ns/persistence">

    <persistence-unit name="salesopsPU" transaction-type="JTA">

        <jta-data-source>java:/SalesOpsDS</jta-data-source>

        <!-- WildFly scans @Entity classes automatically, no need to list them here -->

        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>

</persistence>
